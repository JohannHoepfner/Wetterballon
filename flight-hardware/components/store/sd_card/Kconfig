menu "SD_CARD"
    config SD_CARD_MOUNT_POINT
        string "SD card mount point"
        default "/sdcard"

    config SD_CARD_PIN_MOSI
        int "MOSI GPIO number"
        default 5

    config SD_CARD_PIN_MISO
        int "MISO GPIO number"
        default 4

    config SD_CARD_PIN_CLK
        int "CLK GPIO number"
        default 6

    config SD_CARD_PIN_CS
        int "CS GPIO number"
        default 0
endmenu
