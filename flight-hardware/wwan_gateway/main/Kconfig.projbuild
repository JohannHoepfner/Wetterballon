menu "WWAN gateway configuration"
    config WWAN_GATEWAY_MODEM_PPP_APN
        string "Set MODEM APN"
        default "internet"
        help
            Set APN (Access Point Name), a logical name to choose data network

    config WWAN_GATEWAY_NOTIFICATION_SMS_RECEIPIENT
        string "Receipient for sms notifictions"
        help
            Sms notification receipient

    menu "data collection server configuration"
        config WWAN_GATEWAY_SERVER_HOST
            string "Host of data collection server"
        config WWAN_GATEWAY_SERVER_HTTP_PORT
            int "Http port of data collection server"
        config WWAN_GATEWAY_SERVER_HTTP_USERNAME
            string "Http auth username of data collection server"
        config WWAN_GATEWAY_SERVER_HTTP_PASSWORD
            string "Http auth password of data collection server"
    endmenu

    menu "UART Configuration"
        config WWAN_GATEWAY_MODEM_PWK_PIN
            int "PWK Pin Number"
            default 11
            range 0 56
            help
                Pin number of modem PWK

        config WWAN_GATEWAY_MODEM_UART_TX_PIN
            int "TXD Pin Number"
            default 20
            range 0 56
            help
                Pin number of UART TX.

        config WWAN_GATEWAY_MODEM_UART_RX_PIN
            int "RXD Pin Number"
            default 21
            range 0 56
            help
                Pin number of UART RX.

        config WWAN_GATEWAY_MODEM_UART_RTS_PIN
            int "RTS Pin Number"
            default 23
            range 0 56
            help
                Pin number of UART RTS.

        config WWAN_GATEWAY_MODEM_UART_CTS_PIN
            int "CTS Pin Number"
            default 22
            range 0 56
            help
                Pin number of UART CTS.

        config WWAN_GATEWAY_MODEM_UART_EVENT_TASK_STACK_SIZE
            int "UART Event Task Stack Size"
            range 2000 6000
            default 2048
            help
                Stack size of UART event task.

        config WWAN_GATEWAY_MODEM_UART_EVENT_TASK_PRIORITY
            int "UART Event Task Priority"
            range 3 22
            default 5
            help
                Priority of UART event task.

        config WWAN_GATEWAY_MODEM_UART_EVENT_QUEUE_SIZE
            int "UART Event Queue Size"
            range 10 40
            default 30
            help
                Length of UART event queue.

        config WWAN_GATEWAY_MODEM_UART_PATTERN_QUEUE_SIZE
            int "UART Pattern Queue Size"
            range 10 40
            default 20
            help
                Length of UART pattern queue.

        config WWAN_GATEWAY_MODEM_UART_TX_BUFFER_SIZE
            int "UART TX Buffer Size"
            range 256 2048
            default 512
            help
                Buffer size of UART TX buffer.

        config WWAN_GATEWAY_MODEM_UART_RX_BUFFER_SIZE
            int "UART RX Buffer Size"
            range 256 2048
            default 1024
            help
                Buffer size of UART RX buffer.

        choice WWAN_GATEWAY_FLOW_CONTROL
            bool "Set preferred modem control flow"
            default WWAN_GATEWAY_FLOW_CONTROL_NONE
            help
                Set the modem's preferred control flow

            config WWAN_GATEWAY_FLOW_CONTROL_NONE
                bool "No control flow"
            config WWAN_GATEWAY_FLOW_CONTROL_SW
                bool "SW control flow"
            config WWAN_GATEWAY_FLOW_CONTROL_HW
                bool "HW control flow"
        endchoice
    endmenu
endmenu
